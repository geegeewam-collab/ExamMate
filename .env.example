# ---------- Server (set these on Vercel: Project > Settings > Environment Variables) ----------
# Password for /admin and for owner sign-in in the app. Long and private.
ADMIN_PASSWORD=
# Signs activation tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# YOUR Gemini key (Google AI Studio). Used ONLY for owner devices. Students bring their own.
GEMINI_API_KEY=
# Optional: pin a model, e.g. gemini-2.5-flash. Leave empty to auto-pick the newest Flash model.
GEMINI_MODEL=
# Where your APK releases live, as owner/repo. Needed for "Update available" notifications in the app.
# If you leave it empty the server falls back to the GitHub repo Vercel deployed from. Set it when the APKs are
# published in a separate public repo (the RELEASES_REPO variable in GitHub Actions).
RELEASES_REPO=
# Added automatically when you connect Upstash Redis to the Vercel project:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Android app build only (put in .env.local on your computer) ----------
# Your deployed site, no trailing slash. The website itself needs nothing here.
NEXT_PUBLIC_API_URL=https://exam-mate-one.vercel.app
# Set automatically by the release workflow (the number from your tag, e.g. 1.0.1). Only set it by hand for a local test build.
NEXT_PUBLIC_APP_VERSION=
# Optional (set on Vercel): override where the /download page points. Normally worked out from your GitHub repo.
NEXT_PUBLIC_APK_URL=
# Optional: shown on the activation screen as "Need a license? Get one". WhatsApp, website or mailto: link.
NEXT_PUBLIC_SUPPORT_URL=
