# Public app URL embedded in native builds; set to your deployed ExamMate site.
NEXT_PUBLIC_API_URL=https://your-exammate-domain.example
NEXT_PUBLIC_SUPPORT_URL=

# Server-only secrets. Never commit real values.
ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-16-characters
TOKEN_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# Optional compatible Upstash/Vercel KV variable names.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
