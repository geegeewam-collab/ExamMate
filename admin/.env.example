# Password for /admin. Make it long and unique.
ADMIN_PASSWORD=
# Signs activation tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Google AI Studio key. Stays on the server; students never see it.
GEMINI_API_KEY=
# Optional: pin a model, e.g. gemini-2.5-flash. Leave empty to auto-pick.
GEMINI_MODEL=
# Optional: photos each license may answer per day (default 60).
DAILY_LIMIT=60
# Added automatically when you connect Upstash Redis to the Vercel project:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
